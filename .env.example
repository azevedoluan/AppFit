# ==============================================================================
# APPFIT - CONFIGURAÇÕES DE AMBIENTE
# ==============================================================================

# Porta do Servidor Backend
PORT=3001

# Banco de Dados PostgreSQL
PGHOST=localhost
PGPORT=5432
PGDATABASE=appfit_db
PGUSER=postgres
PGPASSWORD=sua_senha_postgres

# ------------------------------------------------------------------------------
# Configurações de Envio de E-mail (SMTP)
# Suporta: GoDaddy, Gmail, Resend, SendGrid, Brevo, Outlook, etc.
# ------------------------------------------------------------------------------
# Para Gmail: host=smtp.gmail.com, port=587, user=seu@gmail.com, pass=senha_de_app (16 digitos)
# Para GoDaddy: host=smtpout.secureserver.net, port=465 (secure=true) ou 587
# Para Resend: host=smtp.resend.com, port=587, user=resend, pass=re_seu_token
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="AppFit" <noreply@appfit.luanmazevedo.dev>
